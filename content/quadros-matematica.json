    {
     "nome": "Função afim (1º grau)",
     "def": "Gráfico é uma reta; a = inclinação, b = onde corta o eixo y.",
     "itens": "f(x) = ax + b · raiz: x = -b/a · a > 0 crescente",
     "ex": "f(x) = 3x - 6 → raiz x = 2, crescente."
    },
    {
     "nome": "Função quadrática (2º grau)",
     "def": "Gráfico é parábola: a > 0 boca para cima (mínimo); a < 0 para baixo (máximo).",
     "itens": "f(x) = ax² + bx + c",
     "ex": "f(x) = x² - 4x + 3 → raízes 1 e 3."
    },
    {
     "nome": "Bhaskara e Δ",
     "def": "Acha as raízes; Δ diz quantas existem.",
     "itens": "Δ = b² - 4ac · x = (-b ± √Δ)/2a · Δ>0 duas, Δ=0 uma, Δ<0 nenhuma real",
     "ex": "Δ = 16 - 12 = 4 → x = (4 ± 2)/2."
    },
    {
     "nome": "Vértice",
     "def": "Ponto de máximo ou mínimo da parábola.",
     "itens": "x_v = -b/2a · y_v = f(x_v)",
     "ex": "-2x² + 8x - 6 → (2, 2), máximo."
    },
    {
     "nome": "Exponencial",
     "def": "Variável no expoente; nunca toca o eixo x.",
     "itens": "f(x) = a·bˣ · b > 1 cresce · 0 < b < 1 decresce",
     "ex": "Juros compostos: M = C·(1,01)ˣ."
    },
    {
     "nome": "Logarítmica",
     "def": "Inversa da exponencial de mesma base.",
     "itens": "f(x) = log_b(x) · só para x > 0",
     "ex": "log₂ 8 = 3."
    },
    {
     "nome": "Polinômio",
     "def": "Grau = maior expoente com coeficiente não nulo; raiz zera P(x).",
     "itens": "P(x) = aₙxⁿ + … + a₀",
     "ex": "x³ - 6x² + 11x - 6 tem grau 3."
    },
    {
     "nome": "Briot-Ruffini",
     "def": "Divide P(x) por (x - r) quando r é raiz; baixa o grau em 1.",
     "itens": "Teste raízes entre os divisores do termo constante",
     "ex": "Raiz 1 → quociente x² - 5x + 6 → raízes 1, 2, 3."
    }
