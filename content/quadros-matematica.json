  {
   "titulo": "Progressões: PA x PG",
   "rotulos": {
    "itens": "Fórmula",
    "ex": "Exemplo"
   },
   "linhas": [
    {
     "nome": "PA: definição",
     "def": "Cada termo = anterior + razão r (SOMA).",
     "itens": "aₙ = a₁ + (n-1)·r",
     "ex": "a₁ = 3, r = 5 → a₆ = 28."
    },
    {
     "nome": "PA: razão por dois termos",
     "def": "Não precisa de a₁.",
     "itens": "aₙ - aₘ = (n - m)·r",
     "ex": "a₃ = 11, a₇ = 27 → r = 4."
    },
    {
     "nome": "PA: soma",
     "def": "Soma dos n primeiros termos.",
     "itens": "Sₙ = n·(a₁ + aₙ)/2",
     "ex": "2, 5, 8… → S₁₀ = 155."
    },
    {
     "nome": "PG: definição",
     "def": "Cada termo = anterior × razão q (MULTIPLICAÇÃO).",
     "itens": "aₙ = a₁·qⁿ⁻¹",
     "ex": "a₁ = 3, q = 2 → a₅ = 48."
    },
    {
     "nome": "PG: razão por dois termos",
     "def": "Divida um termo pelo outro.",
     "itens": "aₙ = aₘ·qⁿ⁻ᵐ",
     "ex": "a₂ = 6, a₅ = 48 → q³ = 8 → q = 2."
    },
    {
     "nome": "PG: soma finita",
     "def": "Soma dos n primeiros termos (q ≠ 1).",
     "itens": "Sₙ = a₁·(qⁿ - 1)/(q - 1)",
     "ex": "1 + 2 + 4 + 8 = 15."
    },
    {
     "nome": "PG: soma infinita",
     "def": "Só converge se |q| < 1.",
     "itens": "S = a₁/(1 - q)",
     "ex": "1/3 + 1/9 + … = 1/2."
    },
    {
     "nome": "PG: produto",
     "def": "Termos equidistantes dos extremos têm produto a₁·aₙ.",
     "itens": "Pₙ = (a₁·aₙ)^(n/2)",
     "ex": "a₁ = 2, a₆ = 64 → P₆ = 128³."
    },
    {
     "nome": "Interpolação",
     "def": "Inserir k meios: a sequência fica com k + 2 termos.",
     "itens": "Use aₙ com n = k + 2",
     "ex": "3 meios entre 2 e 32 → 2, 4, 8, 16, 32."
    },
    {
     "nome": "Padrão misto",
     "def": "Ache o bloco que se repete e some blocos.",
     "itens": "Soma = nº de blocos × soma do bloco",
     "ex": "1, 2, -3 repetido: 12 termos somam 0."
    }
   ]
