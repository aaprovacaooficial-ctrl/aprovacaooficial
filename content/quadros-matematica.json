     "ex": "Mesmo método de substituição."
    },
    {
     "nome": "Sistemas lineares",
     "def": "Substituição, adição ou Cramer (determinantes).",
     "itens": "Somar equações para eliminar variável",
     "ex": "x + y = 10 e x - y = 4 → x = 7, y = 3."
